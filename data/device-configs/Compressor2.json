{
  "device_name": "Compressor",
  "class_name": "Compressor2", 
  "description": "Ableton Live's built-in compressor device",
  "version": "1.0.0",
  "priority": "important",
  "parameters": {
    "essential": [
      {
        "index": 0,
        "name": "Threshold",
        "description": "Compression threshold level",
        "range": { "min": -60, "max": 0, "default": -12 },
        "units": "dB",
        "type": "continuous",
        "update_rate": "moderate"
      },
      {
        "index": 1,
        "name": "Ratio",
        "description": "Compression ratio",
        "range": { "min": 1, "max": 20, "default": 3 },
        "units": ":1",
        "type": "continuous", 
        "update_rate": "moderate"
      },
      {
        "index": 6,
        "name": "Gain",
        "description": "Output gain compensation",
        "range": { "min": 0, "max": 30, "default": 0 },
        "units": "dB",
        "type": "continuous",
        "update_rate": "moderate"
      }
    ],
    "important": [
      {
        "index": 2,
        "name": "Attack",
        "description": "Attack time",
        "range": { "min": 0.01, "max": 100, "default": 10 },
        "units": "ms",
        "type": "continuous",
        "update_rate": "slow"
      },
      {
        "index": 3,
        "name": "Release",
        "description": "Release time", 
        "range": { "min": 1, "max": 1000, "default": 60 },
        "units": "ms",
        "type": "continuous",
        "update_rate": "slow"
      }
    ],
    "useful": [
      {
        "index": 4,
        "name": "Env Type",
        "description": "Envelope follower type (Peak/RMS)",
        "type": "discrete",
        "update_rate": "slow"
      },
      {
        "index": 5,
        "name": "Knee",
        "description": "Compression knee hardness",
        "range": { "min": 0, "max": 1, "default": 0.5 },
        "type": "continuous",
        "update_rate": "slow"
      },
      {
        "index": 8,
        "name": "Makeup",
        "description": "Auto makeup gain toggle",
        "range": { "min": 0, "max": 1, "default": 1 },
        "type": "discrete",
        "update_rate": "slow"
      }
    ],
    "optional": [
      {
        "index": 7,
        "name": "Dry/Wet",
        "description": "Dry/wet mix",
        "range": { "min": 0, "max": 1, "default": 1 },
        "units": "%",
        "type": "continuous",
        "update_rate": "moderate"
      }
    ]
  }
}