        "units": "dB",
        "type": "continuous",
        "update_rate": "moderate"
      },
      {
        "index": 1,
        "name": "Ratio",
        "description": "Compression ratio",
        "range": { "min": 2, "max": 10, "default": 4 },
        "units": ":1",
        "type": "continuous",
        "update_rate": "moderate"
      },
      {
        "index": 5,
        "name": "Makeup",
        "description": "Output makeup gain",
        "range": { "min": 0, "max": 20, "default": 0 },
        "units": "dB",
        "type": "continuous",
        "update_rate": "moderate"
      }
    ],
    "important": [
      {
        "index": 2,
        "name": "Attack",
        "description": "Attack time",
        "range": { "min": 0.03, "max": 30, "default": 10 },
        "units": "ms",
        "type": "continuous",
        "update_rate": "slow"
      },
      {
        "index": 3,
        "name": "Release",
        "description": "Release time",
        "range": { "min": 0.1, "max": 1, "default": 0.5 },
