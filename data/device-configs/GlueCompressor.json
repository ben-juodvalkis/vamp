    "useful": [
      {
        "index": 4,
        "name": "Range",
        "description": "Maximum gain reduction",
        "range": { "min": 0, "max": 40, "default": 0 },
        "units": "dB",
        "type": "continuous",
        "update_rate": "slow"
      },
      {
        "index": 7,
        "name": "Peak Clip",
        "description": "Peak limiting switch",
        "type": "boolean",
        "update_rate": "slow"
      }
