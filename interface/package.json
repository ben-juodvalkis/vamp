		"@sveltejs/vite-plugin-svelte": "^6.2.3",
		"@tailwindcss/vite": "^4.0.0",
		"@testing-library/jest-dom": "^6.9.1",
		"@testing-library/svelte": "^5.3.1",
		"@types/node": "^24.5.0",
		"@vite-pwa/sveltekit": "^1.0.0",
		"@vitest/coverage-v8": "^4.1.4",
		"bits-ui": "^2.11.4",
		"clsx": "^2.1.1",
		"jsdom": "^27.4.0",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwind-merge": "^3.3.1",
		"tailwind-variants": "^1.0.0",
		"tailwindcss": "^4.0.0",
		"tw-animate-css": "^1.3.8",
		"typescript": "^5.0.0",
		"vite": "^7.0.4",
		"vitest": "^4.0.16"
	},
	"dependencies": {
		"audio-decode": "^3.10.1",
		"lucide-svelte": "^0.543.0"
	},
	"//optionalDependencies": "Per-platform native binaries for lightningcss and @tailwindcss/oxide (transitive deps of vite / @tailwindcss/vite). Pinned exact so every platform's variant is recorded in the lockfile; each package's os/cpu guard makes npm install only the host's match. Keep these versions in sync with the transitively-resolved versions when vite/tailwind are bumped — verify with `npm ls lightningcss @tailwindcss/oxide`.",
	"optionalDependencies": {
		"lightningcss-darwin-arm64": "1.30.1",
		"lightningcss-darwin-x64": "1.30.1",
