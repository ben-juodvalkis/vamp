<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- The Node inside Vamp for Mac (installer.plan.md Phase 3), signed with the
     hardened runtime: V8 compiles JavaScript to machine code as it runs,
     which the hardened runtime forbids without these two. Node's own macOS
     release is signed with the same pair. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
